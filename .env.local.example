# GitHub — optional but strongly recommended.
# Unauthenticated requests are capped at 60/hour; a token raises this to 5,000/hour.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# LLM providers — set whichever preset(s) you plan to use as defaults.
# Users can also override the key per-request from the UI.
GROQ_API_KEY=
NIM_API_KEY=